**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# === Secrets & env ===
.env
.env.*
*.env

# === Signing keys (NEVER commit) ===
*.jks
*.keystore
key.properties
!**/debug.keystore

# === Firebase / Google services ===
**/google-services.json
**/GoogleService-Info.plist

# === Build artifacts ===
*.apk
*.aab
*.ipa
*.tar.gz
*.zip

# === Stray/temp ===
*.tmp
*.bak
*.orig

# === AI-tool leftovers (must never be in this repo) ===
/skills/
/tools/
/download/

# === Vosk model cache (downloaded at runtime, never commit) ===
**/vosk-model-ru/
**/vosk-model-small-ru-*/

# === Local databases ===
*.db
*.db-journal

# === Android local config (SDK paths, JDK paths) ===
**/local.properties
